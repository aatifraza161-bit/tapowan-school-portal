{
  "name": "school-management-system",
  "version": "1.0.1",
  "description": "Full working school management system with local server",
  "author": "Tapowan Public School",
  "main": "electron-main.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "echo 'skip build (static frontend served by Vercel)'",
    "build-win": "electron-builder --win"
  },
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1127.0",
    "@google/genai": "^1.48.0",
    "@libsql/client": "^0.17.4",
    "@supabase/supabase-js": "^2.112.0",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.2",
    "express-session": "^1.18.1",
    "googleapis": "^171.4.0",
    "mammoth": "^1.12.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "node-forge": "^1.4.0",
    "nodemailer": "^8.0.7",
    "paytmchecksum": "^1.5.1",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "serverless-http": "^4.0.0",
    "sharp": "^0.35.3",
    "yt-search": "^2.13.1"
  },
  "build": {
    "appId": "com.educore.school",
    "productName": "EduCore",
    "compression": "maximum",
    "asar": true,
    "asarUnpack": [
      "START_FACE_SERVER.bat",
      "face_server/dist/face_server.exe",
      "vidya_voice_ai/**/*"
    ],
    "files": [
      "**/*",
      "!dist/**/*",
      "!dist",
      "!app_extracted/**/*",
      "!temp_extract/**/*",
      "!student-mobile-app/**/*",
      "!android/**/*",
      "!src/**/*",
      "!test/**/*",
      "!scripts/**/*",
      "!kaggle/**/*",
      "!scratch/**/*",
      "!.vercel/**/*",
      "!.netlify/**/*",
      "!.wrangler/**/*",
      "!public/*.apk",
      "!public/bundles/**/*",
      "!public/bundles",
      "!public/*.pdf",
      "!public/*.mp4",
      "!face_server/*.py",
      "!face_server/*.spec",
      "!face_server/*.log",
      "!*.apk",
      "!*.ipynb",
      "!*.zip",
      "!*.asar",
      "!*.log",
      "!*.txt"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "public/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "EduCore",
      "runAfterFinish": true,
      "installerIcon": "public/icon.ico",
      "uninstallerIcon": "public/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^26.15.3"
  }
}
