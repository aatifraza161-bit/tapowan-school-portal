wOffset:{width:0,height:1},shadowOpacity:.04,shadowRadius:3,elevation:1},savedAvatarContainer:{position:'relative',marginRight:(0,c.scale)(10)},savedAvatarImg:{width:(0,c.scale)(42),height:(0,c.scale)(42),borderRadius:(0,c.scale)(21),borderWidth:1,borderColor:'#e2e8f0'},savedAvatarFallback:{width:(0,c.scale)(42),height:(0,c.scale)(42),borderRadius:(0,c.scale)(21),backgroundColor:'#eff6ff',justifyContent:'center',alignItems:'center',borderWidth:1,borderColor:'#bfdbfe'},savedClassBadge:{position:'absolute',bottom:-(0,c.scale)(3),right:-(0,c.scale)(3),backgroundColor:'#2563eb',paddingHorizontal:(0,c.scale)(4),paddingVertical:(0,c.scale)(1),borderRadius:(0,c.scale)(6)},savedClassBadgeText:{fontSize:(0,c.scaleFont)(8.5),fontWeight:'800',color:'#ffffff'},savedProfileInfo:{flex:1,marginRight:(0,c.scale)(8)},savedProfileName:{fontSize:(0,c.scaleFont)(13.5),fontWeight:'700',color:'#0f172a'},savedProfileMeta:{fontSize:(0,c.scaleFont)(11),color:'#64748b',marginTop:2},savedProfileMetaBold:{color:'#334155',fontWeight:'700'},oneTapBtn:{flexDirection:'row',alignItems:'center',backgroundColor:'#16a34a',paddingHorizontal:(0,c.scale)(10),paddingVertical:(0,c.scale)(7),borderRadius:(0,c.scale)(10),shadowColor:'#16a34a',shadowOffset:{width:0,height:2},shadowOpacity:.25,shadowRadius:4,elevation:2},oneTapBtnText:{color:'#ffffff',fontSize:(0,c.scaleFont)(11.5),fontWeight:'800'},removeSavedBtn:{padding:(0,c.scale)(6),marginLeft:(0,c.scale)(6),backgroundColor:'#f8fafc',borderRadius:(0,c.scale)(8),borderWidth:1,borderColor:'#f1f5f9'},savedDividerWrap:{flexDirection:'row',alignItems:'center',marginTop:(0,c.verticalScale)(8),marginBottom:(0,c.verticalScale)(2)},savedDividerText:{fontSize:(0,c.scaleFont)(10),fontWeight:'700',color:'#94a3b8',marginHorizontal:(0,c.scale)(8),letterSpacing:.5}})},2644,[1,2,53,571,108,4,2645,809,2646,2647,2655,2656,2662,2663,242,2844]);
