__d(function(g,_r,_i,a,m,_e,d){var e=_r(d[0]);Object.defineProperty(_e,"__esModule",{value:!0}),_e.default=function(e){var l=e.visible,p=e.onClose,u=e.onFaceCaptured,h=e.onEmbeddingDetected,b=e.isProcessing,w=(0,t.useState)(''),x=(0,n.default)(w,2),v=x[0],y=x[1],E=(0,t.useState)(''),C=(0,n.default)(E,2),T=C[0],I=C[1],D=(0,t.useState)('https://trans-choir-spotlight-sponsored.trycloudflare.com'),F=(0,n.default)(D,2),L=F[0],k=F[1];(0,t.useEffect)(function(){if(l){var e=function(){return Math.random().toString(16).substring(2,6)},n=`${e()}${e()}-${e()}-4${e().substring(1)}-${e()}-${e()}${e()}`;y(n);var t=new Date,i=t.getFullYear(),r=String(t.getMonth()+1).padStart(2,'0'),o=String(t.getDate()).padStart(2,'0'),c=String(t.getHours()).padStart(2,'0'),f=String(t.getMinutes()).padStart(2,'0');I(`${i}-${r}-${o} ${c}:${f}`),(0,s.getFaceServerUrl)().then(function(e){e&&k(e)})}},[l]);var S=`\n<!DOCTYPE html>\n<html>\n<head>\n  <meta charset="utf-8">\n  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">\n  \x3c!-- Load Client-Side Edge AI Face-API --\x3e\n  <script src="https://cdn.jsdelivr.net/npm/@vladmandic/face-api@1.7.12/dist/face-api.min.js"><\/script>\n  <style>\n    * { box-sizing: border-box; margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }\n    body, html { width: 100%; height: 100%; background: #ffffff; color: #0f172a; overflow: hidden; display: flex; flex-direction: column; align-items: center; justify-content: center; }\n    \n    .scanner-container {\n      position: relative;\n      width: 100%;\n      height: 100%;\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      justify-content: center;\n    }\n    \n    .circle-frame {\n      position: relative;\n      width: 270px;\n      height: 270px;\n      border-radius: 50%;\n      border: 4.5px solid #ef4444; /* Default Red when scanning */\n      overflow: hidden;\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);\n      background: #f1f5f9;\n      transition: border-color 0.25s ease, box-shadow 0.25s ease;\n      cursor: pointer;\n    }\n\n    .circle-frame.matched {\n      border-color: #10b981 !important; /* Green when face is locked */\n      box-shadow: 0 0 25px rgba(16, 185, 129, 0.5) !important;\n    }\n    \n    video {\n      position: absolute;\n      width: 100%;\n      height: 100%;\n      object-fit: cover;\n      transform: scaleX(-1);\n    }\n\n    video.back-cam {\n      transform: none;\n    }\n    \n    .face-overlay-svg {\n      position: absolute;\n      width: 100%;\n      height: 100%;\n      top: 0;\n      left: 0;\n      z-index: 10;\n      pointer-events: none;\n    }\n    \n    .instruction-text {\n      font-size: 16px;\n      font-weight: 700;\n      color: #1e293b;\n      letter-spacing: 0.8px;\n      margin-top: 32px;\n      text-transform: uppercase;\n      text-align: center;\n      transition: color 0.25s;\n    }\n\n    .instruction-text.matched {\n      color: #10b981;\n    }\n\n    .ai-badge {\n      display: inline-flex;\n      align-items: center;\n      gap: 6px;\n      padding: 4px 12px;\n      border-radius: 20px;\n      background: rgba(16, 185, 129, 0.1);\n      color: #10b981;\n      font-size: 11px;\n      font-weight: 800;\n      margin-top: 10px;\n      letter-spacing: 0.5px;\n    }\n    \n    .cam-btn {\n      width: 56px;\n      height: 56px;\n      border-radius: 50%;\n      background: #f8fafc;\n      border: 1px solid #e2e8f0;\n      box-shadow: 0 4px 14px rgba(0, 0, 0, 0.1);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      margin-top: 20px;\n      cursor: pointer;\n      active: scale(0.95);\n      transition: transform 0.1s;\n    }\n\n    .cam-btn svg {\n      width: 24px;\n      height: 24px;\n      stroke: #334155;\n    }\n    \n    canvas { display: none; }\n  </style>\n</head>\n<body>\n  <div class="scanner-container">\n    <div class="circle-frame" id="circleFrame" onclick="manualCapture()" title="Tap to capture instantly">\n      <video id="webcam" autoplay playsinline muted></video>\n      \n      \x3c!-- Exact Aadhaar FaceRD Dotted Head & Eyes Outline --\x3e\n      <svg class="face-overlay-svg" viewBox="0 0 270 270" fill="none" xmlns="http://www.w3.org/2000/svg">\n        \x3c!-- Dotted Oval Head Outline --\x3e\n        <ellipse id="headOutline" cx="135" cy="135" rx="72" ry="98" stroke="#1e293b" stroke-width="2.2" stroke-dasharray="5 5" opacity="0.85"/>\n        \n        \x3c!-- Left Eyebrow --\x3e\n        <path d="M96 112 C104 106, 116 106, 122 112" stroke="#1e293b" stroke-width="2.2" stroke-linecap="round" fill="none"/>\n        \x3c!-- Left Eye --\x3e\n        <ellipse cx="109" cy="124" rx="10" ry="7" stroke="#1e293b" stroke-width="2" fill="none"/>\n        <circle cx="109" cy="124" r="3.5" fill="#1e293b"/>\n        \n        \x3c!-- Right Eyebrow --\x3e\n        <path d="M148 112 C154 106, 166 106, 174 112" stroke="#1e293b" stroke-width="2.2" stroke-linecap="round" fill="none"/>\n        \x3c!-- Right Eye --\x3e\n        <ellipse cx="161" cy="124" rx="10" ry="7" stroke="#1e293b" stroke-width="2" fill="none"/>\n        <circle cx="161" cy="124" r="3.5" fill="#1e293b"/>\n      </svg>\n    </div>\n\n    <div class="instruction-text" id="instruct">INITIALIZING EDGE AI...</div>\n    <div class="ai-badge">\u26a1 CLIENT-SIDE AI \u2022 100% 24/7 OFFLINE</div>\n\n    \x3c!-- Camera Switch / Flip Button --\x3e\n    <button class="cam-btn" id="flipBtn" onclick="toggleCamera()" title="Switch Camera">\n      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">\n        <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>\n        <circle cx="12" cy="13" r="4"></circle>\n        <path d="M8 12h.01M16 12h.01"></path>\n      </svg>\n    </button>\n  </div>\n\n  <canvas id="canvas"></canvas>\n\n  <script>\n    const GPU_SERVER_URL = "${L}";\n    const video = document.getElementById('webcam');\n    const canvas = document.getElementById('canvas');\n    const circleFrame = document.getElementById('circleFrame');\n    const instruct = document.getElementById('instruct');\n    const headOutline = document.getElementById('headOutline');\n\n    let currentFacingMode = 'user';\n    let isDetecting = false;\n    let autoCaptured = false;\n    let checkInterval = null;\n    let isModelLoaded = false;\n\n    async function loadEdgeAiModels() {\n      try {\n        instruct.innerText = 'LOADING AI MODELS...';\n        const MODEL_URL = 'https://cdn.jsdelivr.net/gh/cgarciagl/face-api.js@master/weights';\n        await Promise.all([\n          faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL),\n          faceapi.nets.faceLandmark68TinyNet.loadFromUri(MODEL_URL),\n          faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL)\n        ]);\n        isModelLoaded = true;\n        instruct.innerText = 'ALIGN FACE IN CIRCLE';\n      } catch (e) {\n        console.warn('Fallback: Model load error, using fast camera trigger:', e);\n        isModelLoaded = false;\n        instruct.innerText = 'ALIGN FACE & BLINK';\n      }\n    }\n\n    async function initCamera() {\n      if (video.srcObject) {\n        video.srcObject.getTracks().forEach(t => t.stop());\n      }\n\n      try {\n        const stream = await navigator.mediaDevices.getUserMedia({\n          video: {\n            facingMode: currentFacingMode,\n            width: { ideal: 480 },\n            height: { ideal: 480 }\n          },\n          audio: false\n        });\n        video.srcObject = stream;\n        video.className = (currentFacingMode === 'environment') ? 'back-cam' : '';\n        await video.play();\n        startAutoScanLoop();\n      } catch (err) {\n        instruct.innerText = 'CAMERA ACCESS REQUIRED';\n      }\n    }\n\n    function toggleCamera() {\n      currentFacingMode = (currentFacingMode === 'user') ? 'environment' : 'user';\n      initCamera();\n    }\n\n    function startAutoScanLoop() {\n      if (checkInterval) clearInterval(checkInterval);\n      \n      let stableFrames = [];\n\n      checkInterval = setInterval(async () => {\n        if (!video.videoWidth || isDetecting || autoCaptured) return;\n        isDetecting = true;\n\n        try {\n          // 1. Ultra-Fast Colab GPU Face Extraction (~30ms on Tesla T4)\n          if (typeof GPU_SERVER_URL !== 'undefined' && GPU_SERVER_URL && GPU_SERVER_URL.startsWith('http')) {\n            try {\n              canvas.width = Math.min(video.videoWidth, 480);\n              canvas.height = Math.min(video.videoHeight, 480);\n              const ctx = canvas.getContext('2d');\n              ctx.drawImage(video, 0, 0, canvas.width, canvas.height);\n              const blob = await new Promise(r => canvas.toBlob(r, 'image/jpeg', 0.85));\n              if (blob) {\n                const fd = new FormData();\n                fd.append('file', blob, 'face.jpg');\n                const ctrl = new AbortController();\n                const tid = setTimeout(() => ctrl.abort(), 3500);\n                const resp = await fetch(GPU_SERVER_URL + '/extract', {\n                  method: 'POST',\n                  body: fd,\n                  headers: { 'ngrok-skip-browser-warning': 'true' },\n                  signal: ctrl.signal\n                });\n                clearTimeout(tid);\n                if (resp.ok) {\n                  const data = await resp.json();\n                  if (data.faces && data.faces.length > 0) {\n                    const emb = data.faces[0].embedding;\n                    if (emb && emb.length > 0) {\n                      stableFrames.push(emb);\n                      circleFrame.classList.add('matched');\n                      instruct.classList.add('matched');\n                      instruct.innerText = 'FACE DETECTED \u2022 HOLD STILL...';\n                      headOutline.setAttribute('stroke', '#10b981');\n\n                      if (stableFrames.length >= 2) {\n                        autoCaptured = true;\n                        clearInterval(checkInterval);\n                        instruct.innerText = 'BIOMETRICS LOCKED \u2022 VERIFYING...';\n                        const fullBase64 = canvas.toDataURL('image/jpeg', 0.90);\n                        if (window.ReactNativeWebView) {\n                          window.ReactNativeWebView.postMessage(JSON.stringify({\n                            type: 'EMBEDDING_DETECTED',\n                            embedding: emb,\n                            photoBase64: fullBase64\n                          }));\n                        }\n                        isDetecting = false;\n                        return;\n                      }\n                      isDetecting = false;\n                      return;\n                    }\n                  }\n                }\n              }\n            } catch(gpuErr) {\n              // Gracefully continue to client-side faceapi fallback\n            }\n          }\n          if (isModelLoaded && typeof faceapi !== 'undefined') {\n            const detection = await faceapi.detectSingleFace(\n              video,\n              new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.55 })\n            ).withFaceLandmarks(true).withFaceDescriptor();\n\n            if (detection && detection.descriptor) {\n              stableFrames.push(Array.from(detection.descriptor));\n              \n              circleFrame.classList.add('matched');\n              instruct.classList.add('matched');\n              instruct.innerText = 'FACE DETECTED \u2022 HOLD STILL...';\n              headOutline.setAttribute('stroke', '#10b981');\n\n              // Require 2 stable consecutive frames for biometric precision\n              if (stableFrames.length >= 2) {\n                autoCaptured = true;\n                clearInterval(checkInterval);\n\n                instruct.innerText = 'BIOMETRICS LOCKED \u2022 VERIFYING...';\n\n                // Average the 2 frames\n                const len = stableFrames[0].length;\n                const averagedEmbedding = new Array(len);\n                for (let i = 0; i < len; i++) {\n                  averagedEmbedding[i] = (stableFrames[0][i] + stableFrames[1][i]) / 2;\n                }\n\n                canvas.width = 320;\n                canvas.height = 320;\n                const ctx = canvas.getContext('2d');\n                const webpCandidate = canvas.toDataURL('image/webp', 0.90);\n                const fullBase64 = (webpCandidate && webpCandidate.indexOf('data:image/webp') === 0) ? webpCandidate : canvas.toDataURL('image/jpeg', 0.90);\n\n                if (window.ReactNativeWebView) {\n                  window.ReactNativeWebView.postMessage(JSON.stringify({\n                    type: 'EMBEDDING_DETECTED',\n                    embedding: averagedEmbedding,\n                    photoBase64: fullBase64\n                  }));\n                }\n                isDetecting = false;\n                return;\n              }\n\n              isDetecting = false;\n              return;\n            } else {\n              stableFrames = [];\n            }\n          }\n\n          circleFrame.classList.remove('matched');\n          instruct.classList.remove('matched');\n          instruct.innerText = 'ALIGN FACE IN CIRCLE';\n          headOutline.setAttribute('stroke', '#1e293b');\n\n        } catch (e) {\n          console.warn('Edge scan frame error:', e);\n        }\n        isDetecting = false;\n      }, 250);\n    }\n\n    async function manualCapture() {\n      if (autoCaptured) return;\n      if (!video.videoWidth || isDetecting) return;\n      isDetecting = true;\n\n      try {\n        instruct.innerText = 'ANALYZING BIOMETRICS...';\n        if (isModelLoaded && typeof faceapi !== 'undefined') {\n          const detection = await faceapi.detectSingleFace(\n            video,\n            new faceapi.TinyFaceDetectorOptions({ inputSize: 320, scoreThreshold: 0.45 })\n          ).withFaceLandmarks(true).withFaceDescriptor();\n\n          if (detection && detection.descriptor) {\n            autoCaptured = true;\n            if (checkInterval) clearInterval(checkInterval);\n\n            circleFrame.classList.add('matched');\n            instruct.classList.add('matched');\n            instruct.innerText = 'FACE CAPTURED \u2022 VERIFYING...';\n            headOutline.setAttribute('stroke', '#10b981');\n\n            canvas.width = 320;\n            canvas.height = 320;\n            const ctx = canvas.getContext('2d');\n            const webpCandidate = canvas.toDataURL('image/webp', 0.90);\n            const fullBase64 = (webpCandidate && webpCandidate.indexOf('data:image/webp') === 0) ? webpCandidate : canvas.toDataURL('image/jpeg', 0.90);\n\n            if (window.ReactNativeWebView) {\n              window.ReactNativeWebView.postMessage(JSON.stringify({\n                type: 'EMBEDDING_DETECTED',\n                embedding: Array.from(detection.descriptor),\n                photoBase64: fullBase64\n              }));\n            }\n            return;\n          }\n        }\n        instruct.innerText = 'NO FACE DETECTED \u2022 TRY AGAIN';\n      } catch (e) {\n        console.warn('Manual capture error:', e);\n      } finally {\n        isDetecting = false;\n      }\n    }\n\n    // Initialize AI & Camera on load\n    window.addEventListener('DOMContentLoaded', async () => {\n      await loadEdgeAiModels();\n      await initCamera();\n    });\n    setTimeout(async () => {\n      if (!isModelLoaded) await loadEdgeAiModels();\n      initCamera();\n    }, 400);\n  <\/script>\n</body>\n</html>\n  `;return(0,c.jsx)(i.Modal,{visible:l,animationType:"slide",transparent:!1,onRequestClose:p,children:(0,c.jsxs)(i.SafeAreaView,{sty