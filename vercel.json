{
  "version": 2,
  "regions": ["bom1"],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/generate-monthly-dues",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/cleanup-call-logs",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/TPS-Original-App.apk",
      "destination": "https://tapowan-whatsapp-gateway.onrender.com/TPS-Original-App.apk",
      "permanent": false
    },
    {
      "source": "/Karz-e-Hasan.apk",
      "destination": "https://tapowan-whatsapp-gateway.onrender.com/Karz-e-Hasan.apk",
      "permanent": false
    },
    {
      "source": "/CabHUB.apk",
      "destination": "https://tapowan-whatsapp-gateway.onrender.com/CabHUB.apk",
      "permanent": false
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|gif|ico|svg|woff|woff2|ttf|map)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/banners/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
