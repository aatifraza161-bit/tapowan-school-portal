{
  "version": 2,
  "regions": [
    "bom1"
  ],
  "functions": {
    "api/index.js": {
      "memory": 256,
      "maxDuration": 15
    }
  },
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/generate-monthly-dues",
      "schedule": "0 0 1 * *"
    },
    {
      "path": "/api/cron/cleanup-call-logs",
      "schedule": "0 2 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/Karz-e-Hasan.apk",
      "destination": "https://tapowan-whatsapp-gateway.onrender.com/Karz-e-Hasan.apk",
      "permanent": false
    },
    {
      "source": "/CabHUB.apk",
      "destination": "https://tapowan-whatsapp-gateway.onrender.com/CabHUB.apk",
      "permanent": false
    },
    {
      "source": "/super-admin",
      "destination": "https://tps-erp-saas.vercel.app/super-admin",
      "permanent": false
    },
    {
      "source": "/super-admin/:path*",
      "destination": "https://tps-erp-saas.vercel.app/super-admin/:path*",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/educore",
      "destination": "/educore.html"
    },
    {
      "source": "/ecosystem",
      "destination": "/educore.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/banners/(.*)",
      "destination": "/api/index.js"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains; preload"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(self), geolocation=(self)"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self' https://tapowan-school.vercel.app https://tapowan-app.vercel.app; script-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com https://unpkg.com https://*.unpkg.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://unpkg.com https://*.unpkg.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://tapowan-school.vercel.app https://tapowan-app.vercel.app https://*.vercel.app https://*.pages.dev https://*.turso.io https://unpkg.com https://*.unpkg.com; frame-ancestors 'none';"
        }
      ]
    },
    {
      "source": "/(.*)\\.apk",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/vnd.android.package-archive"
        },
        {
          "key": "Content-Disposition",
          "value": "attachment; filename=TPS-Original-App.apk"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|webp|gif|ico|svg|woff|woff2|ttf|map)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, s-maxage=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(index\\.html|educore\\.html|educore|sw\\.js|app\\.js|reports_module\\.js|exam_module\\.js|online_classes_module\\.js|slip-templates\\.js|online_payments_module\\.js|style\\.css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/banners/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, s-maxage=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/bundles/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
